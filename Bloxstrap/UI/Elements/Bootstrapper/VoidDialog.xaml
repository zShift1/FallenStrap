<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Bootstrapper.VoidDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:Bloxstrap.UI.ViewModels.Bootstrapper"
    Width="560"
    Height="320"
    MinHeight="0"
    d:DataContext="{d:DesignInstance vms:BootstrapperDialogViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="Black"
    Closing="UiWindow_Closing"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <Storyboard x:Key="VoidOrbAnimation">
            <DoubleAnimation Storyboard.TargetName="VoidOrb1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-40" To="60" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="VoidOrb1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-30" To="40" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="VoidOrb2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="50" To="-60" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="VoidOrb2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="40" To="-50" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="VoidGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.16" To="0.38" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource VoidOrbAnimation}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0A11" Offset="0" />
                <GradientStop Color="#0F0E1A" Offset="0.55" />
                <GradientStop Color="#0B0A13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse x:Name="VoidOrb1" Width="520" Height="520" Margin="-260,-260,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3A2266" Offset="0" />
                    <GradientStop Color="#3A2266" Offset="0.4" />
                    <GradientStop Color="#003A2266" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="VoidOrb2" Width="480" Height="480" Margin="0,0,-240,-240" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4C2E8F" Offset="0" />
                    <GradientStop Color="#4C2E8F" Offset="0.4" />
                    <GradientStop Color="#004C2E8F" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!--  Top purple aura  -->
        <Border Height="160" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.5">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#7C4DFF" Offset="0" />
                    <GradientStop Color="#007C4DFF" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Ellipse x:Name="VoidGlow" Width="340" Height="220" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-40,0,0" IsHitTestVisible="False" Opacity="0.2">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8C5CFF" Offset="0" />
                    <GradientStop Color="#8C5CFF" Offset="0.5" />
                    <GradientStop Color="#008C5CFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!--  Allow for drag  -->
        <ui:TitleBar
            VerticalAlignment="Top"
            CanMaximize="False"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Margin="40,20,40,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Width="90"
                Height="90"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#14141F"
                BorderBrush="#3A2A6A"
                BorderThickness="1"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#7C4DFF" Opacity="0.6" />
                </Border.Effect>
                <Image
                    Width="52"
                    Height="52"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon, Mode=OneWay}" />
            </Border>

            <TextBlock
                Grid.Row="1"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#EDEDF5"
                Text="{Binding Title, Mode=OneWay}" />

            <TextBlock
                Grid.Row="2"
                Margin="12,10,12,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="#9E9EB6"
                Text="{Binding Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <ProgressBar
                Grid.Row="3"
                Height="6"
                Background="#1B1B28"
                BorderThickness="0"
                Foreground="#7C4DFF"
                IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                Value="{Binding ProgressValue, Mode=OneWay}" />

            <Button
                Grid.Row="4"
                Width="120"
                Margin="0,20,0,0"
                Padding="4"
                HorizontalAlignment="Center"
                Background="#1E1E2C"
                BorderBrush="#3A3A50"
                Command="{Binding CancelInstallCommand}"
                Content="{x:Static resources:Strings.Common_Cancel}"
                FontSize="14"
                Foreground="#E8E8F2"
                IsEnabled="{Binding CancelEnabled, Mode=OneWay}"
                Visibility="{Binding CancelButtonVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</base:WpfUiWindow>