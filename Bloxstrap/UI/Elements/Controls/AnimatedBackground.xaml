<UserControl x:Class="Bloxstrap.UI.Elements.Controls.AnimatedBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <Storyboard x:Key="OrbAnimation">

            <DoubleAnimation Storyboard.TargetName="Orb1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-90" To="90" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-50" To="60" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Orb2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="80" To="-100" Duration="0:0:32" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="60" To="-70" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Orb3"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="40" To="-80" Duration="0:0:36" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Orb3"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-60" To="50" Duration="0:0:28" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Glow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.10" To="0.24" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource FallenStrap.BaseColor1}" Offset="0" />
                <GradientStop Color="{DynamicResource FallenStrap.BaseColor2}" Offset="0.55" />
                <GradientStop Color="{DynamicResource FallenStrap.BaseColor3}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse x:Name="Orb1" Width="860" Height="860" Margin="-300,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.16">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource FallenStrap.Orb1Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource FallenStrap.Orb1Color}" Offset="0.35" />
                    <GradientStop Color="{DynamicResource FallenStrap.Orb1Fade}" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Orb2" Width="1000" Height="1000" Margin="0,0,-380,-380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource FallenStrap.Orb2Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource FallenStrap.Orb2Color}" Offset="0.4" />
                    <GradientStop Color="{DynamicResource FallenStrap.Orb2Fade}" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Orb3" Width="700" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.10">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource FallenStrap.Orb3Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource FallenStrap.Orb3Color}" Offset="0.5" />
                    <GradientStop Color="{DynamicResource FallenStrap.Orb3Fade}" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Glow" Width="520" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource FallenStrap.GlowColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource FallenStrap.GlowColor}" Offset="0.6" />
                    <GradientStop Color="{DynamicResource FallenStrap.GlowFade}" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>