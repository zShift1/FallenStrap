<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:vms="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DesignHeight="760"
      d:DesignWidth="820"
      d:DataContext="{d:DesignInstance vms:HomeViewModel, IsDesignTimeCreatable=True}"
      Title="HomePage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">

        <!--  Hero  -->
        <Border CornerRadius="14" Padding="28" BorderBrush="#2E2450" BorderThickness="1" Margin="0,0,0,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#221A3D" Offset="0" />
                    <GradientStop Color="#12121D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#7C4DFF" Opacity="0.3" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName, Mode=OneTime}" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding VersionText, Mode=OneTime}" FontSize="14" Foreground="#9E9EB6" Margin="0,4,0,0" />
                    <TextBlock Text="Tu lanzador de Roblox, con estilo." FontSize="15" Foreground="#C9C9DD" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Background="#1A1A28" CornerRadius="10" Padding="12,7" Margin="0,0,8,0">
                            <TextBlock FontSize="12" Foreground="#8F8FAA" Text="{Binding RobloxStatus, Mode=OneWay}" />
                        </Border>
                        <Border Background="#1A1A28" CornerRadius="10" Padding="12,7">
                            <TextBlock FontSize="12" Foreground="#8F8FAA">
                                <Run Text="Perfil: " />
                                <Run Text="{Binding ActiveProfile, Mode=OneWay}" FontWeight="SemiBold" Foreground="#C9C9DD" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    Width="170"
                    Height="48"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding PlayNowCommand, Mode=OneTime}"
                    Content="Jugar Roblox"
                    FontSize="16"
                    FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!--  Presets rápidos  -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Presets rápidos de lanzamiento" />
                    <TextBlock FontSize="12" Text="Aplica el límite de FPS con un solo clic. Los cambios se guardan al instante." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Límite de FPS actual: " />
                    <Run Text="{Binding CurrentFpsCap, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="60 FPS" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyFpsCommand, Mode=OneTime}" CommandParameter="60" />
                    <ui:Button Content="120 FPS" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyFpsCommand, Mode=OneTime}" CommandParameter="120" />
                    <ui:Button Content="144 FPS" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyFpsCommand, Mode=OneTime}" CommandParameter="144" />
                    <ui:Button Content="240 FPS" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyFpsCommand, Mode=OneTime}" CommandParameter="240" />
                    <ui:Button Content="360 FPS" MinWidth="80" Command="{Binding ApplyFpsCommand, Mode=OneTime}" CommandParameter="360" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" FontSize="12" Text="Nota: el límite se aplica mediante la Fast Flag DFIntTaskSchedulerTargetFps." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardExpander>

        <!--  Calidad gráfica  -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Calidad gráfica" />
                    <TextBlock FontSize="12" Text="Ajusta la calidad del renderizado y la resolución interna con un solo clic. Se guarda al instante." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Calidad actual: " />
                    <Run Text="{Binding CurrentGraphicsQuality, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Baja" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyQualityCommand, Mode=OneTime}" CommandParameter="3" />
                    <ui:Button Content="Media" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyQualityCommand, Mode=OneTime}" CommandParameter="8" />
                    <ui:Button Content="Alta" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyQualityCommand, Mode=OneTime}" CommandParameter="14" />
                    <ui:Button Content="Máxima" Margin="0,0,8,0" MinWidth="80" Command="{Binding ApplyQualityCommand, Mode=OneTime}" CommandParameter="21" />
                    <ui:Button Content="Predeterminada" MinWidth="100" Command="{Binding ApplyQualityCommand, Mode=OneTime}" CommandParameter="" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" FontSize="12" Text="Nota: la calidad se aplica mediante la Fast Flag DFIntDebugFRMQualityLevelOverride. Los valores van del 0 (mínima) al 21 (máxima)." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardExpander>

        <!--  Perfiles  -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Perfiles" />
                    <TextBlock FontSize="12" Text="Cada perfil guarda su propia configuración y sus Fast Flags. Cambiar de perfil reinicia la aplicación." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox
                    Grid.Column="0"
                    Height="180"
                    Margin="0,0,4,0"
                    ItemsSource="{Binding ProfilesList, Mode=OneWay}"
                    SelectedItem="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Crear nuevo perfil" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nombre del perfil" />
                        <ui:Button Grid.Column="1" Content="Crear" Command="{Binding AddProfileCommand, Mode=OneTime}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            Appearance="Primary"
                            Content="Cambiar a este perfil"
                            Command="{Binding SwitchProfileCommand, Mode=OneTime}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Appearance="Danger"
                            Content="Eliminar"
                            Command="{Binding DeleteProfileCommand, Mode=OneTime}" />
                    </Grid>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Text="Los mods, las integraciones y los atajos son compartidos entre todos los perfiles."
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </ui:CardExpander>
    </StackPanel>
</ui:UiPage>