<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#151515" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#3A9CEA" />

    <!-- FallenStrap dark theme: near-black base with dark gray surfaces.
         Only *Brush keys are overridden here - the *Color keys must stay
         native Color objects that WPF UI defines in its themes dictionary. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF0F0F0F" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="LayerFillColorSubtleBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF232323" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF9B9B9B" />

    <!-- FallenStrap AnimatedBackground palette (dark) -->
    <Color x:Key="FallenStrap.BaseColor1">#0A0A0A</Color>
    <Color x:Key="FallenStrap.BaseColor2">#050505</Color>
    <Color x:Key="FallenStrap.BaseColor3">#0D0D0D</Color>
    <Color x:Key="FallenStrap.Orb1Color">#3A3A3A</Color>
    <Color x:Key="FallenStrap.Orb1Fade">#003A3A3A</Color>
    <Color x:Key="FallenStrap.Orb2Color">#2E2E2E</Color>
    <Color x:Key="FallenStrap.Orb2Fade">#002E2E2E</Color>
    <Color x:Key="FallenStrap.Orb3Color">#242424</Color>
    <Color x:Key="FallenStrap.Orb3Fade">#00242424</Color>
    <Color x:Key="FallenStrap.GlowColor">#1E1E1E</Color>
    <Color x:Key="FallenStrap.GlowFade">#001E1E1E</Color>
</ResourceDictionary>