<base:WpfUiWindow x:Class="FallenStrap.UI.Elements.About.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:FallenStrap.UI.Elements.About.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:FallenStrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:FallenStrap.Resources"
             xmlns:controls="clr-namespace:FallenStrap.UI.Elements.Controls"
             mc:Ignorable="d"
             Title="{x:Static resources:Strings.About_Title}"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             MinWidth="800"
             Width="800"
             Height="440"
             ExtendsContentIntoTitleBar="True"
             WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:AnimatedBackground Grid.RowSpan="2" Panel.ZIndex="-1" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.About_Title}" Icon="pack://application:,,,/FallenStrap.ico" />

        <pages:AboutPage Grid.Row="1" Margin="12" />
    </Grid>
</base:WpfUiWindow>
