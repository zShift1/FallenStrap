<base:WpfUiWindow x:Class="FallenStrap.UI.Elements.Dialogs.DiscordPopupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:FallenStrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="FallenStrap"
        MinWidth="0"
        MinHeight="0"
        Width="218"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <base:WpfUiWindow.Resources>
        <Style x:Key="AnimatedDiscordButton" TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.09" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.09" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </base:WpfUiWindow.Resources>

    <Border CornerRadius="16" BorderBrush="#3F3F3F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F21A1A1A" Offset="0" />
                <GradientStop Color="#F20D0D0D" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="16,16,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Width="46" Height="46" HorizontalAlignment="Center" CornerRadius="12" Background="#1F1F1F">
                    <Image Width="30" Height="30" Source="pack://application:,,,/FallenStrap.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="FallenStrap" FontSize="15" FontWeight="Bold" Foreground="White" />
                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" Text="Únete a nuestro Discord" FontSize="10.5"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Center" Padding="20,7" Cursor="Hand"
                    Style="{StaticResource AnimatedDiscordButton}"
                    Click="OpenDiscordButton_Click" Background="#5865F2" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.6" Color="#5865F2" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5561E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4752C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform" Fill="White"
                          Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM16.3088 15.0108c-1.1815 0-2.1614-1.0857-2.1614-2.4195 0-1.3339.9528-2.4195 2.1614-2.4195 1.2085 0 2.1884 1.0959 2.1613 2.4195 0 1.3339-.9528 2.4195-2.1613 2.4195zm-6.8758 0c-1.1815 0-2.1614-1.0857-2.1614-2.4195 0-1.3339.9528-2.4195 2.1614-2.4195 1.2084 0 2.1884 1.0959 2.1613 2.4195 0 1.3339-.9527 2.4195-2.1613 2.4195z" />
                    <TextBlock Text="Open Discord" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Row="2" Margin="0,9,0,0" HorizontalAlignment="Center" Padding="42,6.5" Cursor="Hand"
                    Click="CloseButton_Click" Background="#3A3A3A" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Close" FontWeight="SemiBold" FontSize="11.5" />
            </Button>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <ProgressBar x:Name="CountdownBar" Minimum="0" Maximum="100" Value="100" Height="3" Background="#2A2A2A" Foreground="#E5484D" />
            </Grid>
        </Grid>
    </Border>
</base:WpfUiWindow>