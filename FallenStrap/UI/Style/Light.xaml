<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#0F6CBD" />

    <!-- FallenStrap light theme: near-white base with light gray surfaces.
         Only *Brush keys are overridden here - the *Color keys must stay
         native Color objects that WPF UI defines in its themes dictionary. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFF4F4F8" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFF7F7F9" />
    <SolidColorBrush x:Key="LayerFillColorSubtleBrush" Color="#FFF0F0F4" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFD4D4DC" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1A1A22" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF3E3E4E" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6E6E80" />

    <!-- FallenStrap AnimatedBackground palette (light) -->
    <Color x:Key="FallenStrap.BaseColor1">#F4F4F8</Color>
    <Color x:Key="FallenStrap.BaseColor2">#F9F9FB</Color>
    <Color x:Key="FallenStrap.BaseColor3">#EEF0F4</Color>
    <Color x:Key="FallenStrap.Orb1Color">#C9C9D8</Color>
    <Color x:Key="FallenStrap.Orb1Fade">#00C9C9D8</Color>
    <Color x:Key="FallenStrap.Orb2Color">#B8B8CA</Color>
    <Color x:Key="FallenStrap.Orb2Fade">#00B8B8CA</Color>
    <Color x:Key="FallenStrap.Orb3Color">#ADADC2</Color>
    <Color x:Key="FallenStrap.Orb3Fade">#00ADADC2</Color>
    <Color x:Key="FallenStrap.GlowColor">#DCDCE8</Color>
    <Color x:Key="FallenStrap.GlowFade">#00DCDCE8</Color>
</ResourceDictionary>